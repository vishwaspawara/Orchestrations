ip link add name br0 type bridge
ip addr add 172.20.0.1/24 dev br0
ip link set br0 up

sudo modprobe tun

echo allow br0 > /etc/qemu/bridge.conf

sudo sysctl net.ipv4.ip_forward=1
sudo sysctl net.ipv6.conf.default.forwarding=1
sudo sysctl net.ipv6.conf.all.forwarding=1

sudo ip tuntap add dev tap0 mode tap
sudo ip tuntap add dev tap1 mode tap
sudo ip tuntap add dev tap2 mode tap

sudo ip link set tap0 master br0
sudo ip link set tap0 up
sudo ip link set tap1 master br0
sudo ip link set tap1 up
sudo ip link set tap2 master br0
sudo ip link set tap2 up

sudo iptables -t nat -A POSTROUTING -o wlp0s20f3 -j MASQUERADE
sudo iptables -A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
sudo iptables -A FORWARD -i tap0 -o wlp0s20f3 -j ACCEPT
sudo iptables -A FORWARD -i tap1 -o wlp0s20f3 -j ACCEPT
sudo iptables -A FORWARD -i tap2 -o wlp0s20f3 -j ACCEPT
